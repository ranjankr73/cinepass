generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------
//                 ENUMS 
// -----------------------------------

// -------- Identity & Access --------

// Platform-wide role of a user account.
// USER          - default customer
// ADMIN         - internal staff / back-office
// THEATRE_OWNER - granted only via an APPROVED RoleRequest
enum Role {
  USER
  ADMIN
  THEATRE_OWNER
}

// Account lifecycle state. Blocking is preferred over hard deletion.
enum UserStatus {
  ACTIVE
  BLOCKED
}

// Purpose of a one-time verification token.
// EMAIL_VERIFY   - confirm email ownership
// PASSWORD_RESET - password reset flow
// PHONE_OTP      - phone OTP login/verification
enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  PHONE_OTP
}

// Review state of a request to become a THEATRE_OWNER.
enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// -------- Catalogue --------

// Visibility state of a movie in the catalogue.
// COMING_SOON - announced / advance booking
// NOW_SHOWING - currently bookable
// ARCHIVED    - no longer listed
enum MovieStatus {
  COMING_SOON
  NOW_SHOWING
  ARCHIVED
}

// Indian CBFC certification ratings.
enum MovieCertificate {
  U
  UA
  A
  S
}

// Operating state of a theatre.
// INACTIVE is the default (onboarding / paused).
enum TheatreStatus {
  ACTIVE
  INACTIVE
}

// Projection / audio format of a screen.
enum ScreenType {
  STANDARD
  THREE_D
  IMAX
  FOUR_DX
  DOLBY_ATMOS
}

// ---------- Shows & Seat Availability ----------

// Lifecycle of a scheduled show.
// COMPLETED is a terminal state for reporting/archival.
enum ShowStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

// Per-seat state for a given show.
// LOCKED = temporary hold during checkout (see ShowSeat.lockedUntil).
enum SeatStatus {
  AVAILABLE
  LOCKED
  BOOKED
}

// ---------- Bookings ----------

// Lifecycle of a booking.
// PENDING   - seats locked, awaiting payment
// CONFIRMED - paid and seats booked
// CANCELLED - user/system cancelled
// EXPIRED   - payment window elapsed / lock died
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

// ---------- Payments & Refunds ----------

// State of a payment attempt against a booking.
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// Supported payment instruments.
enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
  EMI
}

// State of a refund against a payment.
enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// -----------------------------------
//                 MODELS 
// -----------------------------------

// -------- Identity & Access --------

// A platform user. Customers, theatre owners, and admins share one table,
// distinguished by `role`. Soft-deleted via `deletedAt`.
model User {
  id            Int        @id @default(autoincrement())
  name          String
  email         String     @unique // primary login identity
  phone         String?    @unique // optional secondary identity
  password      String // hashed, never plaintext
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE) // BLOCKED denies login/actions
  emailVerified Boolean    @default(false)
  phoneVerified Boolean    @default(false)
  lastLoginAt   DateTime?

  // Relations
  sessions      Session[]
  verifications VerificationToken[]
  roleRequests  RoleRequest[]       @relation("RoleRequestUser")
  theatres      Theatre[] // only meaningful for THEATRE_OWNER
  bookings      Booking[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  @@index([status])
}

// A refresh-token session. Tokens are rotated; `familyId` ties a rotation
// chain together so token-reuse can be detected and the family revoked.
model Session {
  id          Int       @id @default(autoincrement())
  userId      Int
  refreshHash String    @unique // hash of the current refresh token
  familyId    String // rotation family (reuse detection)
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime? // set on logout / reuse detection

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([familyId])
}

// A one-time token for email verification, password reset, or phone OTP.
// Stored hashed; `attempts` caps brute-force retries.
model VerificationToken {
  id         Int                   @id @default(autoincrement())
  userId     Int
  type       VerificationTokenType
  tokenHash  String                @unique
  expiresAt  DateTime
  consumedAt DateTime? // set once used
  attempts   Int                   @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

// Append-only log of login attempts, used for rate limiting and
// threat detection (per email and per IP).
model LoginAttempt {
  id      BigInt  @id @default(autoincrement())
  email   String
  ip      String
  success Boolean

  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Append-only audit trail for security- and business-relevant events.
// `userId` is nullable to allow system-generated events.
model AuditLog {
  id        BigInt  @id @default(autoincrement())
  userId    Int?
  event     String // e.g. "user.login", "booking.cancelled"
  ip        String?
  userAgent String?
  meta      Json? // arbitrary event payload

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

// A user's request to be promoted to a specific role (currently
// THEATRE_OWNER). `details` holds deferred KYC fields.
model RoleRequest {
  id            Int               @id @default(autoincrement())
  userId        Int
  requestedRole Role // THEATRE_OWNER
  status        RoleRequestStatus @default(PENDING)
  details       Json? // KYC fields, deferred
  reviewedBy    Int? // admin user id
  reviewedAt    DateTime?
  reason        String? // rejection / review note
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user User @relation("RoleRequestUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

// ---------- Catalogue ----------

// A movie title in the catalogue. Soft-deleted via `deletedAt`.
model Movie {
  id          Int               @id @default(autoincrement())
  title       String
  description String
  duration    Int // minutes
  genre       String
  language    String
  releaseDate DateTime          @db.Date // date only, no time component
  poster      String // poster URL
  trailerUrl  String?
  rating      Float? // 0-10
  certificate MovieCertificate?
  status      MovieStatus       @default(COMING_SOON)

  shows Show[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([title])
  @@index([status, releaseDate])
  @@index([language])
}

// A physical cinema owned by a THEATRE_OWNER.
// NOTE: `ownerId` is @unique -> one theatre per owner account.
model Theatre {
  id        Int           @id @default(autoincrement())
  name      String
  address   String
  city      String
  state     String?
  pincode   String?
  latitude  Float?
  longitude Float?
  phone     String
  email     String        @unique
  ownerId   Int           @unique // 1:1 with User (THEATRE_OWNER)
  status    TheatreStatus @default(INACTIVE)

  screens Screen[]

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  @@index([city, status])
  @@index([ownerId])
}

// An auditorium inside a theatre. Name is unique per theatre.
model Screen {
  id         Int        @id @default(autoincrement())
  name       String // e.g. "Screen 1", "Audi 3"
  theatreId  Int
  screenType ScreenType @default(STANDARD)
  totalSeats Int // denormalized count of physical seats
  isActive   Boolean    @default(true) // soft pause without delete

  categories SeatCategory[]
  seats      Seat[]
  shows      Show[]

  theatre Theatre @relation(fields: [theatreId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  @@unique([theatreId, name])
  @@index([theatreId])
}

// ---------- Seat Layout ----------

// A pricing tier within a screen (Silver, Gold, Recliner, ...).
// `basePrice` is the default; per-show overrides live in ShowPricing.
model SeatCategory {
  id        Int     @id @default(autoincrement())
  screenId  Int
  name      String // Silver, Gold, Recliner etc.
  basePrice Decimal @db.Decimal(10, 2)
  isActive  Boolean @default(true)

  seats       Seat[]
  showPricing ShowPricing[]

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([screenId, name])
  @@index([screenId])
}

// A single physical seat in a screen's layout.
// `label` is the human-readable identifier (A1, B2, AA3 ...).
model Seat {
  id         Int     @id @default(autoincrement())
  screenId   Int
  categoryId Int
  row        String // A, B, AA etc
  number     Int // 1, 2, 3 etc
  label      String // A1, B2, AA3 etc
  isActive   Boolean @default(true) // disable a broken/removed seat

  showSeats    ShowSeat[]
  bookingItems BookingItem[]

  screen   Screen       @relation(fields: [screenId], references: [id], onDelete: Restrict)
  category SeatCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([screenId, row, number])
  @@unique([screenId, label])
  @@index([screenId, categoryId])
}

// ---------- Shows ----------

// A single screening of a movie on a screen at a specific date/time.
// `language` optionally overrides Movie.language (e.g. dubbed versions).
model Show {
  id          Int        @id @default(autoincrement())
  date        DateTime   @db.Date
  startTime   DateTime   @db.Time()
  movieId     Int
  screenId    Int
  status      ShowStatus @default(SCHEDULED)
  language    String? // for dubbed versions (different from Movie.language)
  cancelledAt DateTime?

  pricing  ShowPricing[]
  seats    ShowSeat[] // materialized per-seat availability
  bookings Booking[]

  movie  Movie  @relation(fields: [movieId], references: [id], onDelete: Restrict)
  screen Screen @relation(fields: [screenId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  @@unique([screenId, date, startTime]) // no overlapping slots on a screen
  @@index([movieId, date, status])
  @@index([screenId, date])
  @@index([status, date])
}

// Per-show, per-category price override (weekend/evening surcharges, etc.)
// without mutating SeatCategory.basePrice.
// If no entry exists for a category, fall back to SeatCategory.basePrice.
model ShowPricing {
  id         Int     @id @default(autoincrement())
  showId     Int
  categoryId Int
  price      Decimal @db.Decimal(10, 2)

  show     Show         @relation(fields: [showId], references: [id], onDelete: Cascade)
  category SeatCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([showId, categoryId])
  @@index([showId])
}

// One entry per physical seat per show - shows the current state of that seat
// Generated in bulk when a show is created
model ShowSeat {
  id          Int        @id @default(autoincrement())
  showId      Int
  seatId      Int
  status      SeatStatus @default(AVAILABLE)
  price       Decimal    @db.Decimal(10, 2) // snapshot at time of show creation
  lockedUntil DateTime? // when a LOCKED hold expires
  lockedBy    Int? // userId who placed the hold
  bookingId   Int? // current active booking (null when released)

  show    Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  seat    Seat     @relation(fields: [seatId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([showId, seatId])
  @@index([showId, status])
  @@index([bookingId])
  @@index([status, lockedUntil]) // for lock-expiry sweeper
}

// ---------- Bookings ----------

// A customer's purchase for a show.
// `reference` is the public, human-readable id ("BMS-8F3K2L9P");
// never expose the numeric PK.
// Money fields are snapshotted at booking time (all INR).
model Booking {
  id        Int           @id @default(autoincrement())
  reference String        @unique // "BMS-8F3K2L9P" - human-readable, never expose the PK
  showId    Int
  userId    Int
  status    BookingStatus @default(PENDING)

  // Money - all in INR, all snapshotted at booking time
  subtotal       Decimal @db.Decimal(10, 2) // sum of BookingItem.price
  convenienceFee Decimal @default(0) @db.Decimal(10, 2)
  taxes          Decimal @default(0) @db.Decimal(10, 2)
  discount       Decimal @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)

  // Lifecycle
  expiresAt   DateTime? // for PENDING - when the seat lock dies
  confirmedAt DateTime?

  // Cancellation / refund
  cancelledAt  DateTime?
  cancelledBy  Int? // userId or admin id
  cancelReason String?
  refundAmount Decimal   @default(0) @db.Decimal(10, 2)
  refundedAt   DateTime?

  items    BookingItem[] // immutable history
  seats    ShowSeat[] // only populated while booking is active
  payments Payment[]
  refunds  Refund[]

  show Show @relation(fields: [showId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([showId, status])
  @@index([status, expiresAt]) // for expiry sweeper
}

// Immutable record of what was bought.
// Survives cancellation so refunds, support tickets, and analytics still work
// after ShowSeat is released. Seat label/category are denormalized snapshots.
model BookingItem {
  id           Int     @id @default(autoincrement())
  bookingId    Int
  seatId       Int
  seatLabel    String // survives seat layout changes
  categoryName String // survives category renames
  price        Decimal @db.Decimal(10, 2)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  seat    Seat    @relation(fields: [seatId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([bookingId, seatId])
  @@index([bookingId])
  @@index([seatId])
}

// ---------- Payments & refunds ----------

// A payment attempt against a booking. Gateway identifiers are stored
// for reconciliation; `gatewayPaymentId` is the idempotency key.
model Payment {
  id               Int            @id @default(autoincrement())
  bookingId        Int
  amount           Decimal        @db.Decimal(10, 2)
  currency         String         @default("INR")
  method           PaymentMethod?
  status           PaymentStatus  @default(PENDING)
  gateway          String // razorpay, stripe, etc.
  gatewayOrderId   String?
  gatewayPaymentId String?        @unique // gateway-side payment id
  gatewaySignature String? // signature verification payload
  failureReason    String?
  paidAt           DateTime?

  refunds Refund[]

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
}

// A refund issued against a Payment. `gatewayRefundId` tracks the
// gateway-side refund for reconciliation.
model Refund {
  id              Int          @id @default(autoincrement())
  paymentId       Int
  bookingId       Int
  amount          Decimal      @db.Decimal(10, 2)
  status          RefundStatus @default(PENDING)
  reason          String?
  gatewayRefundId String?      @unique
  failureReason   String?
  processedAt     DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([paymentId])
  @@index([status])
}
